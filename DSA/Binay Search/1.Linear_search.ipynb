   "source": [
    "# Linear Search"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "6dfd8b3d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "2\n",
      "None\n"
     ]
    }
   ],
   "source": [
    "def search_linear(nums, target):\n",
    "    n=len(nums)\n",
    "\n",
    "    for i in range(n):\n",
    "        if nums[i]==target:\n",
    "            return i\n",
    "    return None\n",
    "\n",
    "print(search_linear([1,4,6,8],6))\n",
    "print(search_linear([1,4,6,8],9))"
   ]
  },
